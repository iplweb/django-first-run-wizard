msgid "Username"
msgstr "Nazwa użytkownika"

msgid "Required. 150 characters or fewer. Letters, digits and @/./+/-/_ only."
msgstr "Wymagane. Maksymalnie 150 znaków. Tylko litery, cyfry oraz @/./+/-/_."

msgid "Email address"
msgstr "Adres e-mail"

msgid "Required. Used for password reset and admin notices."
msgstr "Wymagane. Używany do resetowania hasła i powiadomień administracyjnych."

msgid "Password"
msgstr "Hasło"

msgid "Password confirmation"
msgstr "Potwierdzenie hasła"

msgid "Enter the same password as before, for verification."
msgstr "Wprowadź to samo hasło ponownie w celu weryfikacji."

msgid "The setup wizard can only run on an empty user table."
msgstr "Kreator konfiguracji może działać wyłącznie na pustej tabeli użytkowników."

msgid "The two password fields didn't match."
msgstr "Hasła w obu polach nie są identyczne."

msgid "Create the administrator account"
msgstr "Utwórz konto administratora"

msgid "Initial system setup"
msgstr "Wstępna konfiguracja systemu"

msgid "No users exist yet. Create the first administrator account to continue."
msgstr ""
"Nie istnieje jeszcze żaden użytkownik. Aby kontynuować, utwórz pierwsze "
"konto administratora."

msgid "Create administrator"
msgstr "Utwórz administratora"

msgid "First-Run Wizard"
msgstr "Kreator pierwszego uruchomienia"

msgid "Setup status"
msgstr "Stan konfiguracji"

msgid "All setup steps have been completed."
msgstr "Wszystkie kroki konfiguracji zostały ukończone."

msgid "The following setup steps still need attention:"
msgstr "Następujące kroki konfiguracji wymagają uwagi:"

msgid "open"
msgstr "otwórz"

msgid "This step was just completed by someone else."
msgstr "Ten krok został przed chwilą ukończony przez kogoś innego."
